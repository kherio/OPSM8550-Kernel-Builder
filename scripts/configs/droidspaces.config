# Droidspaces options that are ABI-safe on a GKI 5.15 tree *together with*
# scripts/patches/droidspaces-sysvipc-kabi-6-7-8.patch (SYSVIPC moved into the
# task_struct ANDROID_KABI padding). Source: Droidspaces-OSS Kernel-Configuration.md.
# CONFIG_CFS_BANDWIDTH and CONFIG_CGROUP_PIDS are deliberately NOT here: they
# resize scheduler/cgroup structures and break every stock vendor module.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# Hardware access
CONFIG_DEVTMPFS=y

# Networking
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y

# Optional but recommended
CONFIG_USER_NS=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
