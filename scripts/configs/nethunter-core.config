# NetHunter kernel options that must survive olddefconfig; the build fails if
# any of them is dropped. Only leaf drivers and USB gadget functions live here:
# nothing that changes the layout of core kernel structures, so the ROM's
# vendor/system_dlkm modules keep matching this Image's symbol CRCs.
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_OBEX=y
CONFIG_USB_CONFIGFS_ECM_SUBSET=y
CONFIG_USB_SERIAL=y
CONFIG_BT_HCIBTUSB=y
