#!/sbin/sh
# Generic KernelSU/Magisk module installer entry point.
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { echo "$1"; }
[ -f /data/adb/ksu/util_functions.sh ] && . /data/adb/ksu/util_functions.sh
[ -f /data/adb/magisk/util_functions.sh ] && . /data/adb/magisk/util_functions.sh
install_module
exit 0
